{
    "$schema": "https://highvaluedata.net/fair-data-schema/dev",
    "$id": "https://highvaluedata.net/fair-data-schema/dev/vocab/refinements",
    "title": "FAIR Refinements Vocabulary Meta-Schema",
    "description": "Demonstrates Mechanism 4: reusable keyword patterns via $defs. Instead of repeating the same annotation bundle on every property, schema authors can $ref shared definitions from this vocabulary.",
    "$defs": {
        "FairAnnotated": {
            "title": "FAIR-Annotated Property Mixin",
            "description": "Attach this mixin (via allOf $ref) to any property to declare the full set of FAIR annotations available on it.",
            "oneOf": [
                {
                    "not": {
                        "anyOf": [
                            { "required": ["fair:instanceVariableRef"] },
                            { "required": ["fair:representedVariableRef"] },
                            { "required": ["fair:conceptualVariableRef"] }
                        ]
                    }
                },
                { "required": ["fair:instanceVariableRef"] },
                { "required": ["fair:representedVariableRef"] },
                { "required": ["fair:conceptualVariableRef"] }
            ],
            "properties": {
                "fair:conceptRef": { "type": "string" },
                "fair:concept": { "type": ["string", "object"] },
                "fair:label": { "type": ["string", "object"] },
                "fair:instanceVariableRef": { "type": "string" },
                "fair:representedVariableRef": { "type": "string" },
                "fair:conceptualVariableRef": { "type": "string" },
                "fair:unitType": { "type": ["string", "object"] },
                "fair:unitTypeRef": { "type": "string" },
                "fair:universe": { "type": ["string", "object"] },
                "fair:universeRef": { "type": "string" },
                "fair:population": { "type": ["string", "object"] },
                "fair:populationRef": { "type": "string" },
                "fair:description": { "type": ["string", "object"] },
                "fair:provider": { "type": ["string", "object"] },
                "fair:providerRef": { "type": "string", "format": "uri" },
                "fair:license": { "type": ["string", "object"] },
                "fair:licenseRef": { "type": "string", "format": "uri" },
                "fair:measurementUnit": { "type": ["string", "object"] },
                "fair:measurementUnitRef": { "type": "string" },
                "fair:quantity": { "type": ["string", "object"] },
                "fair:quantityRef": { "type": "string" },
                "fair:measurementScale": { "type": ["string", "object"] },
                "fair:measurementScaleRef": { "type": "string" },
                "fair:temporalCoverage": {
                    "type": "object",
                    "properties": {
                        "description": { "type": ["string", "object"] },
                        "start": { "type": "string", "format": "date" },
                        "end": { "type": "string", "format": "date" }
                    }
                },
                "fair:temporalCoverageRef": { "type": "string" },
                "fair:spatialCoverage": { "type": ["string", "object"] },
                "fair:spatialCoverageRef": { "type": "string" },
                "fair:measurementTechnique": { "type": ["string", "object"] },
                "fair:measurementTechniqueRef": { "type": "string" },
                "fair:structureType": { "type": "string", "enum": ["wide", "long", "dimensional", "key-value"] },
                "fair:quality": { "type": "array" },
                "fair:classification": {
                    "type": "array",
                    "items": { "type": "string" }
                },
                "fair:version": {
                    "oneOf": [
                        { "type": "string" },
                        { "$ref": "#/$defs/FairVersion" }
                    ]
                }
            }
        },
        "FairVersion": {
            "title": "FAIR Version Descriptor",
            "description": "Reusable version descriptor resource containing version identifier, release date, and release notes.",
            "type": "object",
            "required": ["identifier"],
            "properties": {
                "identifier": {
                    "type": "string",
                    "title": "Version Identifier",
                    "description": "Version identifier string or tag. Semantic Versioning (MAJOR.MINOR.PATCH, e.g. '1.2.0') following https://semver.org is strongly encouraged for compatibility tracking."
                },
                "date": {
                    "type": "string",
                    "format": "date",
                    "title": "Version Release Date",
                    "description": "Publication or release date of this version (ISO 8601 YYYY-MM-DD)."
                },
                "notes": {
                    "type": ["string", "object"],
                    "title": "Version Release Notes",
                    "description": "Markdown-formatted release notes, changelog, breaking changes, or version change rationale."
                }
            }
        },
        "FairUri": {
            "title": "FAIR Persistent URI",
            "type": "string",
            "format": "uri",
            "fair:persistent": true
        },
        "FairCodedValue": {
            "title": "FAIR Coded Value",
            "type": "string",
            "fair:conceptRef": "https://www.w3.org/2004/02/skos/core#Concept"
        },
        "FairDatasetDescriptor": {
            "title": "FAIR Dataset Descriptor",
            "description": "Reusable base object shape for any schema describing an FAIR dataset.",
            "type": "object",
            "required": ["title"],
            "properties": {
                "title": { "type": "string" },
                "description": { "type": ["string", "object"] },
                "fair:description": { "type": ["string", "object"] },
                "fair:version": {
                    "oneOf": [
                        { "type": "string" },
                        { "$ref": "#/$defs/FairVersion" }
                    ]
                },
                "fair:structureType": { "type": "string", "enum": ["wide", "long", "dimensional", "key-value"] },
                "fair:unitType": { "type": ["string", "object"] },
                "fair:unitTypeRef": { "type": "string" },
                "fair:universe": { "type": ["string", "object"] },
                "fair:universeRef": { "type": "string" },
                "fair:population": { "type": ["string", "object"] },
                "fair:populationRef": { "type": "string" },
                "fair:provider": { "$ref": "#/$defs/FairUri" },
                "fair:license": { "$ref": "#/$defs/FairUri" },
                "fair:temporalCoverage": {
                    "type": "object",
                    "properties": {
                        "description": { "type": ["string", "object"] },
                        "start": { "type": "string", "format": "date" },
                        "end": { "type": "string", "format": "date" }
                    }
                }
            }
        },
        "CatalogRecord": {
            "title": "Catalog Record Descriptor",
            "description": "Metadata descriptor for record provenance, administration, and specification conformance (aligned with CDIF Core & W3C DCAT dcat:CatalogRecord).",
            "type": "object",
            "properties": {
                "about": {
                    "type": "string",
                    "format": "uri",
                    "title": "Target Resource URI",
                    "description": "URI pointing back to the main dataset or resource described by this catalog record."
                },
                "conformsTo": {
                    "type": "array",
                    "title": "Conformance Standards",
                    "description": "URIs of standards, profiles, or meta-schemas to which this metadata record conforms (e.g. CDIF profiles or FAIR Data JSON Schema).",
                    "items": {
                        "type": "string",
                        "format": "uri"
                    }
                },
                "sdDatePublished": {
                    "type": "string",
                    "format": "date",
                    "title": "Metadata Update Date",
                    "description": "ISO 8601 date stamp indicating when the metadata record was generated or modified."
                },
                "includedInDataCatalog": {
                    "type": ["string", "object"],
                    "title": "Originating Registry / Data Catalog",
                    "description": "Name or descriptor of the originating catalog or repository."
                },
                "maintainer": {
                    "type": ["string", "object"],
                    "title": "Metadata Maintainer",
                    "description": "Person, Organization, or Agent responsible for maintaining this metadata record."
                }
            }
        }
    }
}
