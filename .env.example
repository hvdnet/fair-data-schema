# FAIR Data JSON Schema API Environment Configuration
# Copy this file to .env and adjust values for your environment.

# Host and Port configuration
HOST=0.0.0.0
PORT=8000

# API Root Path (useful when hosted behind a reverse proxy, e.g. /fair-data-schema)
# Hosted URL example: https://api.highvaluedata.net/fair-data-schema
API_ROOT_PATH=/fair-data-schema

# Path to schemas directory override (optional)
# FAIR_SCHEMA_ROOT=/app
